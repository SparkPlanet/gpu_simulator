{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "EDA_GPU_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "inherits": "base",
      "displayName": "Task 1 CPU debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cpu-release",
      "inherits": "base",
      "displayName": "Task 1 CPU release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "configurePreset": "cpu-release" }
  ],
  "testPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
